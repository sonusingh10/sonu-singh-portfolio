# Public canonical origin.
NEXT_PUBLIC_SITE_URL=https://sonusinghx.com

# Public Formspree form ID (not a secret); form is hidden until configured.
NEXT_PUBLIC_FORMSPREE_FORM_ID=

# Optional privacy-friendly analytics. Leave blank to disable.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=

# Aggregate first-party visit/download counters. Enable the tracker only when
# Cloudflare Pages Functions and the ANALYTICS_DB binding are configured.
NEXT_PUBLIC_ANALYTICS_ENABLED=false

# Keep false to show counts only on the protected /insights page.
NEXT_PUBLIC_SHOW_PUBLIC_COUNTERS=false
